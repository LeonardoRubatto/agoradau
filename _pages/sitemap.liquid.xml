---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}{% if item.url and item.url != '/sitemap.xml' %}  <url><loc>{{ site.url }}{{ item.url }}</loc></url>
{% endif %}{% endfor %}
{% assign articles = site.analyses | concat: site.actualites %}
{% for item in articles %}  <url><loc>{{ site.url }}{{ item.url }}</loc><lastmod>{{ item.date | date: '%Y-%m-%d' }}</lastmod></url>
{% endfor %}
</urlset>
